#!/usr/bin/env bash
# post-commit — spend an identity attestation only after a successful commit.
#
# The pre-commit gate binds the attestation to the exact staged tree (git write-tree
# honours GIT_INDEX_FILE for -a/--only commits). This hook compares that tree with
# HEAD^{tree} before consuming. A failed commit never reaches this hook, so the
# attestation stays alive, still bound to its tree and expiry. A consumption failure
# is logged, never swallowed.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091 # resolved relative to SCRIPT_DIR at runtime
source "$SCRIPT_DIR/../lib/identity_attestation.sh"

log() { printf 'identity-attestation: %s\n' "$1" >&2; }

PATH_FILE="$(ia_path 2>/dev/null)" || exit 0
[[ -f "$PATH_FILE" ]] || exit 0

BOUND="$(ia_field "$PATH_FILE" tree 2>/dev/null || true)"
if [[ -z "$BOUND" ]]; then
    log "no staged tree bound to the attestation; leaving it for expiry"
    exit 0
fi

HEAD_TREE="$(git rev-parse 'HEAD^{tree}' 2>/dev/null)" || {
    log "cannot resolve committed tree; attestation NOT consumed (still bound to $BOUND)"
    exit 0
}

if [[ "$BOUND" != "$HEAD_TREE" ]]; then
    log "tree mismatch (bound $BOUND, committed $HEAD_TREE); attestation NOT consumed"
    exit 0
fi

NONCE="$(ia_field "$PATH_FILE" nonce 2>/dev/null || true)"
BRANCH="$(ia_field "$PATH_FILE" branch 2>/dev/null || true)"
COMMIT="$(git rev-parse HEAD 2>/dev/null || true)"
GIT_DIR="$(git rev-parse --absolute-git-dir 2>/dev/null || true)"

if ! rm -f "$PATH_FILE"; then
    log "consumption failed for $PATH_FILE; attestation remains bound to $BOUND and its expiry"
    exit 0
fi

if [[ -n "$GIT_DIR" ]]; then
    printf '%s consumed nonce=%s branch=%s tree=%s commit=%s\n' \
        "$(date +%s)" "${NONCE:-unknown}" "${BRANCH:-unknown}" "$BOUND" "${COMMIT:-unknown}" \
        >>"${GIT_DIR}/webfang-identity-attestation.log" 2>/dev/null || \
        log "attestation consumed but audit log could not be appended"
fi

log "consumed for branch '${BRANCH:-unknown}' (tree $BOUND)"
exit 0
